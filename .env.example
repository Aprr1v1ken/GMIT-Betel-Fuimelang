# Optional Google Maps browser key
VITE_GOOGLE_MAPS_API_KEY=

# Set a long random value in production so signed sessions survive restarts.
SESSION_SECRET=
# Optional: override the initial local Super Admin password before first seed.
SUPER_ADMIN_PASSWORD=
# Optional Gemini AI configuration. Without it, the app clearly uses local drafts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Durable Postgres/Supabase connection used by the Vercel snapshot adapter.
POSTGRES_URL=
# Optional local PostgreSQL test mode; production Vercel detects itself.
SYSJEGER_USE_POSTGRES=false
