# Optional Google Maps JavaScript API browser key (restrict by HTTP referrer).
# Interactive maps stay hidden without it; manual rayon coordinates still work.
VITE_GOOGLE_MAPS_API_KEY=
# Optional production Map ID for AdvancedMarker. Standard SVG markers are used when empty.
# Do not use Google's DEMO_MAP_ID in production. See docs/GOOGLE_MAPS_SETUP.md.
VITE_GOOGLE_MAPS_MAP_ID=

# Set a long random value in production so signed sessions survive restarts.
SESSION_SECRET=
# Optional: override the initial local Super Admin password before first seed.
SUPER_ADMIN_PASSWORD=
# Optional Gemini AI configuration. Without it, the app clearly uses local drafts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Durable Postgres/Supabase connection used by the Vercel snapshot adapter.
POSTGRES_URL=
# Optional local PostgreSQL test mode; production Vercel detects itself.
SYSJEGER_USE_POSTGRES=false
