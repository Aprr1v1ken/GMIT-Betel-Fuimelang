rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'aprryviken@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(adminId);
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
    }

    // Church Content & Master Data (Warta, Jadwal Ibadah, Majelis, Jemaat)
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    match /schedules/{scheduleId} {
      allow read, write: if true;
    }

    match /church_staff/{staffId} {
      allow read, write: if true;
    }

    match /members/{memberId} {
      allow read, write: if true;
    }

    match /events/{eventId} {
      allow read, write: if true;
    }

    match /activity_images/{imageId} {
      allow read, write: if true;
    }

    // Protected Private Church Collections (Users, Families, Finance)
    match /users/{userId} {
      allow read, write: if true;
    }

    match /families/{familyId} {
      allow read, write: if true;
    }

    match /financial_transactions/{txId} {
      allow read, write: if true;
    }
  }
}
